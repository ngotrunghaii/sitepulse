generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email        String      @unique
  passwordHash String      @default("")
  name         String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  workspaces Workspace[]
  monitors   Monitor[]
  alertRules AlertRule[]
  notificationLogs NotificationLog[]
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  monitors  Monitor[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Monitor {
  id          String        @id @default(cuid())
  name        String
  url         String
  interval    Int           @default(5) // in minutes
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  checks      CheckResult[]
  incidents   Incident[]
  alertRule   AlertRule?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  notificationLogs   NotificationLog[]
  lastStatus         String?
  lastStatusCode     Int?
  lastResponseTimeMs Int?
  lastCheckedAt      DateTime?
  lastErrorMessage   String?
  consecutiveFailures  Int @default(0)
  consecutiveSuccesses Int @default(0)
}

model CheckResult {
  id           String   @id @default(cuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id])
  statusCode   Int?
  responseTime Int?     // in ms
  isUp         Boolean
  attemptCount Int      @default(1)
  errorReason  String?
  checkedAt    DateTime @default(now())
}

model Incident {
  id                 String    @id @default(cuid())
  monitorId          String
  monitor            Monitor   @relation(fields: [monitorId], references: [id])
  startedAt          DateTime  @default(now())
  resolvedAt         DateTime?
  description        String?
  notifiedAt         DateTime?
  resolvedNotifiedAt DateTime?
  notificationLogs   NotificationLog[]
}

model AlertRule {
  id               String   @id @default(cuid())
  monitorId        String   @unique
  monitor          Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled          Boolean  @default(true)
  email            String?
  failureThreshold Int      @default(1)
  notifyOnRecovery Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NotificationLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorId    String?
  monitor      Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  incidentId   String?
  incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  type         String
  recipient    String
  subject      String
  status       String
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}
